{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/reports/[reportId]/generate/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/report/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/rtp-cycles/[rtpCycleId]/export/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/reap-model-runs",
      "schedule": "*/5 * * * *"
    }
  ]
}
