{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,error,loading,not-found,global-error}.tsx",
    "src/app/**/{page,layout,route,error,loading,not-found,global-error}.ts",
    "src/test/**/*.{test,spec}.{ts,tsx}",
    "scripts/**/*.{mjs,mts}",
    "supabase/**"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "src/**/*.css",
    "scripts/**/*.{mjs,mts}"
  ],
  "ignoreIssues": {
    "src/components/ui/**": [
      "files",
      "exports",
      "types",
      "nsExports",
      "nsTypes",
      "enumMembers",
      "duplicates"
    ],
    "src/lib/api/county-geographies.ts": ["files"]
  },
  "ignoreDependencies": ["next-themes", "sonner", "supabase"],
  "ignoreBinaries": ["sha256sum", "jq", "ogrinfo"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "catalog": "error",
    "exports": "warn",
    "nsExports": "warn",
    "types": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "namespaceMembers": "warn",
    "duplicates": "warn"
  },
  "treatConfigHintsAsErrors": true
}
