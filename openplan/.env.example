# OpenPlan environment. Copy to .env.local and fill in.
# What each one enables, and what breaks without it: docs/SELF_HOSTING.md
#
# NEXT_PUBLIC_* values are inlined at BUILD time — changing one needs a rebuild,
# not just a restart.

# --- Required: the app does not work without these -------------------------
# From your own Supabase project, under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses Row Level Security by design. Server-side only; never expose it to a
# browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Free from mapbox.com. Must be a PUBLIC token — these begin with "pk.".
# A secret token ("sk.") will not work in a browser and must not be published.
# Without a valid token every map renders blank.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Legacy alias for the same value, still accepted. Prefer the name above.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Recommended: these features return EMPTY without them -----------------
# Free, issued instantly: https://api.census.gov/data/key_signup.html
# Without it, equity choropleths stay empty, census-tract ingestion does not
# populate, and ACS-backed corridor demographics are unavailable — they return
# no data rather than an error, which looks identical to "nothing here for my
# area".
CENSUS_API_KEY=

# Powers AI drafting, engagement synthesis, translation, moderation, and the
# in-app assistant. Every other module works without it.
ANTHROPIC_API_KEY=

# --- Optional: specific subsystems -----------------------------------------
# Canonical public origin of this deployment (e.g. https://plan.example.gov).
# Governs the canonical URL and social-preview origin of every public page.
# On Vercel it falls back to the deployment URL; on any other host, unset
# means public pages carry no absolute canonical origin.
NEXT_PUBLIC_SITE_URL=

# Path to a Chrome/Chromium binary for report PDF typesetting on a
# non-serverless host (serverless uses the bundled @sparticuz/chromium).
# Falls back to /usr/bin/google-chrome; if no Chrome is found, PDFs are
# produced by the built-in writer tier and say so in the document.
CHROME_EXECUTABLE_PATH=

# Model overrides for each AI surface. Unset uses the defaults compiled into
# the routes. These are cost/quality controls, not feature switches.
OPENPLAN_ASSISTANT_MODEL=
OPENPLAN_GRANTS_AI_MODEL=
OPENPLAN_ENGAGEMENT_SYNTHESIS_MODEL=
OPENPLAN_ENGAGEMENT_TRANSLATION_MODEL=
OPENPLAN_ENGAGEMENT_MODERATION_MODEL=

# Password for the seeded demo user created by `npm run seed:nctc`. Without it
# the seed still succeeds but the demo account cannot be signed into.
OPENPLAN_DEMO_USER_PASSWORD=

# Bearer token gating POST /api/geographies/equity-designation/ingest (the
# operator endpoint that loads equity-designation tract data).
OPENPLAN_EQUITY_INGEST_TOKEN=

# Local filesystem root where a co-located modeling worker writes run
# artifacts, letting the app read them from disk instead of storage. Only for
# single-machine deployments running the worker beside the app.
OPENPLAN_WORKER_LOCAL_ROOT=

# Authorizes /api/cron/reap-model-runs, which turns a crashed model run into a
# truthful failed state instead of leaving it queued forever. Vercel sets and
# sends this automatically.
CRON_SECRET=

# Outbound email. Without these the app does not pretend to send: teammate
# invitations produce a link the inviter copies and sends themselves.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# LEHD LODES vintage used for commute flows.
LODES_YEAR=

# OPTIONAL cap on expensive runs per workspace per month. UNSET = UNLIMITED,
# which is the default and the right setting for a self-hosted deployment.
# Set it only if you operate a public deployment and need to protect your own
# compute; it is an operator limit, not a plan or tier — OpenPlan is free and
# has no paid upgrade. Model-run launches count 5x (they are minutes of
# AequilibraE/ActivitySim compute); everything else counts 1x.
OPENPLAN_MONTHLY_RUN_CAP=

# County onramp worker. Without the URL the app prepares the job and reports
# deliveryMode "prepared" rather than claiming it was submitted.
OPENPLAN_COUNTY_ONRAMP_WORKER_URL=
OPENPLAN_COUNTY_ONRAMP_WORKER_TOKEN=
OPENPLAN_COUNTY_ONRAMP_CALLBACK_BEARER_TOKEN=

# Aerial processing worker (natford-aerial-processing.v1).
# Base URL of the Aerial Intel Platform, e.g. https://aerial-intel.example.com
OPENPLAN_AERIAL_PROCESSING_WORKER_URL=
# Bearer token for dispatching ProcessingRequests; must equal the platform's AERIAL_EXTERNAL_PROCESSING_TOKEN.
OPENPLAN_AERIAL_PROCESSING_WORKER_TOKEN=
# Bearer token the worker presents on ProcessingCallback deliveries; must equal the platform's AERIAL_PROCESSING_CALLBACK_TOKEN.
OPENPLAN_AERIAL_PROCESSING_CALLBACK_BEARER_TOKEN=
# Public base origin of this OpenPlan deployment for worker callbacks (production must set this;
# falls back to the request origin in development).
OPENPLAN_AERIAL_PROCESSING_CALLBACK_URL=

# AequilibraE modeling worker — the OPTIONAL push endpoint.
#
# The worker can be run two ways, and neither costs anything. As a POLLER it
# reads queued runs out of Supabase and the app never calls it, which is what
# these two variables are for skipping. With them SET, the app also PUSHES each
# worker-backed run to the worker's HTTP trigger — which is what lets you run a
# stateless pool that wakes on a request instead of a machine that stays on, and
# is the only configuration in which OpenPlan can tell a planner AT LAUNCH
# whether anything actually took their run.
#
# Both are required together: a URL with no token is refused rather than used,
# because this endpoint starts minutes of compute on request. Set the same token
# on the worker (OPENPLAN_MODELING_WORKER_TOKEN) and run it with
# AEQ_WORKER_MODE=push (or "both" to keep polling as well — the two lanes cannot
# collide: every stage is taken with the same atomic claim, and within the one
# process the worker executes stages one at a time).
# The contract path is appended, so give the base URL: https://worker.example
#
# TWO THINGS A PUSH POOL ASKS OF YOU (workers/aequilibrae_worker/DEPLOY.md has
# the detail): the pool must stay alive while a run drains — the worker answers
# the push immediately and then executes for minutes, so give your platform a
# shutdown grace period at least as long as your longest stage — and CRON_SECRET
# above must be set with the sweep scheduled, because on a push-only deployment
# there is no poller to rescue a run whose worker went away.
OPENPLAN_MODELING_WORKER_URL=
OPENPLAN_MODELING_WORKER_TOKEN=

# Optional operator bound on how many model runs ONE workspace may have waiting
# on the processing worker at once. UNSET MEANS UNLIMITED and the counting query
# is skipped entirely — that is what every self-hosting agency gets. Set it only
# to protect compute you are paying for; the refusal names you, the operator,
# and never offers anyone an upgrade, because OpenPlan is free and has no tiers.
OPENPLAN_MODELING_QUEUE_DEPTH=

# Whether a worker POLLS this deployment. Still needed even with the push
# endpoint above, because they answer different questions: the URL says where a
# run can be pushed, this says whether anything is watching the queue.
#
# The app needs your ANSWER because a poller cannot be probed:
#   deployed | absent
# UNSET means "not declared", and nothing changes — the model launch controls
# go on inferring a missing worker from runs that were queued and then reaped.
# Declaring it is what makes the FIRST launch honest instead of the second: on
# `absent`, worker-backed runs are refused at the button naming this deployment
# rather than being queued and failed fifteen minutes later. It is deployment
# configuration, not a plan or a tier — OpenPlan is free either way — and what
# your runs show outranks it in both directions, so a retired worker cannot go
# on vouching for itself.
#
# IF YOU ONLY PUSH (a pool, nothing polling), LEAVE THIS UNSET. `absent` is
# literally true of that deployment — nothing is watching the queue — and it
# makes the launch button refuse every worker-backed run, including the ones
# your pool would have executed. `deployed` would claim a poller you do not run.
# Unset is the only answer that is both true and working; the push endpoint
# answers at launch, which is better than anything this variable can say.
OPENPLAN_MODELING_WORKER=

# --- Removed ---------------------------------------------------------------
# The Stripe/subscription/plan subsystem has been DELETED. OpenPlan is free and
# open source: there are no plans, no tiers, no quotas by plan, and no payment
# step. These variables no longer do anything and can be removed from any
# deployment:
#   OPENPLAN_STRIPE_*, STRIPE_SECRET_KEY, OPENPLAN_BILLING_*
#
# SWITRS_CSV_PATH is gone: the SWITRS crash export was retired in January 2025,
# and Safety reads the live CCRS API instead.
#
# OPENPLAN_ACCESS_REQUEST_REVIEW_EMAILS and
# OPENPLAN_WORKSPACE_PROVISIONING_SECRET are gone: the /admin operator console
# and the access-request queue were deleted — nothing gates access.
