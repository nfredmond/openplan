# OpenPlan environment. Copy to .env.local and fill in.
# What each one enables, and what breaks without it: docs/SELF_HOSTING.md
#
# NEXT_PUBLIC_* values are inlined at BUILD time — changing one needs a rebuild,
# not just a restart.

# --- Required: the app does not work without these -------------------------
# From your own Supabase project, under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses Row Level Security by design. Server-side only; never expose it to a
# browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Free from mapbox.com. Must be a PUBLIC token — these begin with "pk.".
# A secret token ("sk.") will not work in a browser and must not be published.
# Without a valid token every map renders blank.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Legacy alias for the same value, still accepted. Prefer the name above.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Recommended, and REQUIRED for travel models ---------------------------
# Free, issued instantly, and you must click the activation link in the email —
# an unactivated key is refused exactly like a missing one:
#   https://api.census.gov/data/key_signup.html
#
# REQUIRED to run a travel model. Every model starts from the population,
# households and workers in each area, and the Census Bureau now refuses
# requests that carry no key (it answers with an HTML page, not an error, which
# is why OpenPlan checks for it explicitly before a run starts). Verified
# against the live API 2026-08-15; keyless access used to work and does not now.
#
# Without it, everything else still degrades the old way rather than failing:
# equity choropleths stay empty, census-tract ingestion does not populate, and
# ACS-backed corridor demographics are unavailable — they return no data rather
# than an error, which looks identical to "nothing here for my area".
CENSUS_API_KEY=

# Powers AI drafting, engagement synthesis, translation, moderation, and the
# in-app assistant. Every other module works without it.
ANTHROPIC_API_KEY=

# --- Optional: specific subsystems -----------------------------------------
# Canonical public origin of this deployment (e.g. https://plan.example.gov).
# Governs the canonical URL and social-preview origin of every public page.
# On Vercel it falls back to the deployment URL; on any other host, unset
# means public pages carry no absolute canonical origin.
NEXT_PUBLIC_SITE_URL=

# Path to a Chrome/Chromium binary for report PDF typesetting on a
# non-serverless host (serverless uses the bundled @sparticuz/chromium).
# Falls back to /usr/bin/google-chrome; if no Chrome is found, PDFs are
# produced by the built-in writer tier and say so in the document.
CHROME_EXECUTABLE_PATH=

# Which map backgrounds a member of the public may switch between on an
# engagement portal, in the order they are offered, comma-separated. Known ids:
# streets, satellite, terrain, light, dark. Unset offers streets, satellite,
# terrain and light. Any id OpenPlan does not know is dropped rather than passed
# to Mapbox, because an unknown style loads as a blank rectangle in front of a
# resident; if EVERY id you name is unknown, the default set is offered instead.
# Only Mapbox-published styles can be offered — a style you designed in Mapbox
# Studio loads only for the account that owns it.
# OPENPLAN_PUBLIC_BASEMAPS=
# Which one a public map opens on. Must be one of the ids offered above; if it
# is not, maps open on the first offered background instead.
# OPENPLAN_PUBLIC_BASEMAP_DEFAULT=

# Model overrides for each AI surface. Unset uses the defaults compiled into
# the routes. These are cost/quality controls, not feature switches.
OPENPLAN_ASSISTANT_MODEL=
OPENPLAN_GRANTS_AI_MODEL=
OPENPLAN_ENGAGEMENT_SYNTHESIS_MODEL=
OPENPLAN_ENGAGEMENT_TRANSLATION_MODEL=
OPENPLAN_ENGAGEMENT_MODERATION_MODEL=
# Which model transcribes an adopted plan document into staged figures and
# verbatim chapter text. Defaults to the strong model rather than the cheap one
# on purpose: the job is copying figures out of a table, and a model that
# paraphrases a number is the whole failure mode. Every figure is checked
# against the words it quoted before it is staged, so a cheaper model does not
# produce wrong numbers — it produces fewer figures, each dropped read the
# planner then has to type by hand.
OPENPLAN_RTP_EXTRACTION_MODEL=

# Password for the seeded demo user created by `npm run seed:nctc`. Without it
# the seed still succeeds but the demo account cannot be signed into.
OPENPLAN_DEMO_USER_PASSWORD=

# Bearer token gating POST /api/geographies/equity-designation/ingest (the
# operator endpoint that loads equity-designation tract data).
OPENPLAN_EQUITY_INGEST_TOKEN=

# Local filesystem root where a co-located modeling worker writes run
# artifacts, letting the app read them from disk instead of storage. Only for
# single-machine deployments running the worker beside the app.
OPENPLAN_WORKER_LOCAL_ROOT=

# Authorizes /api/cron/reap-model-runs, which turns a crashed model run into a
# truthful failed state instead of leaving it queued forever. You must SET this
# yourself (openssl rand -hex 32), on Vercel too — Vercel sends the header on
# scheduled runs once the variable exists, but does not create it; unset, the
# reap cron answers 401 on every run.
CRON_SECRET=

# Optional. Enables per-workspace integration keys (workspace owners store
# their own Anthropic/Census keys, encrypted with this secret). High-entropy
# only — openssl rand -hex 32 — never a passphrase; rotating it invalidates
# every stored workspace key. Unset, per-workspace keys are disabled and the
# panel says so. See docs/SELF_HOSTING.md.
OPENPLAN_INTEGRATION_KEY_SECRET=

# Outbound email. Without these the app does not pretend to send: teammate
# invitations produce a link the inviter copies and sends themselves.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# LEHD LODES vintage used for commute flows.
LODES_YEAR=

# OPTIONAL cap on expensive runs per workspace per month. UNSET = UNLIMITED,
# which is the default and the right setting for a self-hosted deployment.
# Set it only if you operate a public deployment and need to protect your own
# compute; it is an operator limit, not a plan or tier — OpenPlan is free and
# has no paid upgrade. Model-run launches count 5x (they are minutes of
# AequilibraE/ActivitySim compute); everything else counts 1x.
OPENPLAN_MONTHLY_RUN_CAP=

# THE MODELING WORKER — the difference between a county run producing a travel
# estimate and producing a job description. Without this URL the app prepares
# the job and reports deliveryMode "prepared" rather than claiming it was
# submitted, and /county-runs says so before you click. That is a supported
# setup, not a broken one.
#
# On your own machine: `npm run modeling:up` starts it in Docker, then set the
# URL and the CALLBACK TOKEN below and restart OpenPlan. `npm run doctor` will
# tell you whether it answered. A run also needs CENSUS_API_KEY above —
# without it every run stops in its first second.
OPENPLAN_COUNTY_ONRAMP_WORKER_URL=
# Only needed when the worker is reachable from beyond this machine — the local
# Docker setup binds it to loopback. Set the SAME value on both sides.
OPENPLAN_COUNTY_ONRAMP_WORKER_TOKEN=
# Where the WORKER should post a finished run back to. Unset, OpenPlan uses the
# address the browser reached it at, which is right whenever the worker can use
# that address too. It cannot from inside a bridge-networked container, where
# "localhost" is the container — set this to http://host.docker.internal:3000
# there, or to the deployment's public URL on a server.
OPENPLAN_COUNTY_ONRAMP_CALLBACK_ORIGIN=
# REQUIRED WHENEVER THE URL ABOVE IS SET, and the failure without it is silent
# and expensive: the worker has no browser session, so the app refuses its
# finished-run callback with 401 after the model has already run for minutes.
# The run simply never appears. Any long random string; it is shared between
# this app and the jobs it sends out, and nothing else ever sees it.
OPENPLAN_COUNTY_ONRAMP_CALLBACK_BEARER_TOKEN=

# Aerial processing worker (natford-aerial-processing.v1 / v1.1).
# Base URL of the processing worker: the Aerial Intel Platform (contract v1), or a self-hosted
# NodeODM worker from workers/odm_worker (contract v1.1), e.g. https://aerial-intel.example.com
# or http://localhost:8484.
OPENPLAN_AERIAL_PROCESSING_WORKER_URL=
# Which contract revision the configured worker speaks. Unset or "v1" (the default): the pasted
# ZIP-link path, byte-identical to what the external platform has always received. "v1.1": the
# dispatch route sends the mission's stored photos (aerial_imagery) as a manifest of signed
# per-photo links; the pasted link remains as the fallback when nothing is stored. Set "v1.1" for
# the workers/odm_worker deployment; any other value makes the route refuse with the reason.
OPENPLAN_AERIAL_PROCESSING_WORKER_CONTRACT=
# How long the signed per-photo links in a v1.1 manifest stay valid, in seconds. The links must
# outlive the worker's ingest of the mission's photos. Optional; unset means 21600 (six hours).
OPENPLAN_AERIAL_IMAGERY_URL_TTL_SECONDS=
# Bearer token for dispatching ProcessingRequests; must equal the platform's AERIAL_EXTERNAL_PROCESSING_TOKEN.
OPENPLAN_AERIAL_PROCESSING_WORKER_TOKEN=
# Bearer token the worker presents on ProcessingCallback deliveries; must equal the platform's AERIAL_PROCESSING_CALLBACK_TOKEN.
OPENPLAN_AERIAL_PROCESSING_CALLBACK_BEARER_TOKEN=
# Public base origin of this OpenPlan deployment for worker callbacks (production must set this;
# falls back to the request origin in development).
OPENPLAN_AERIAL_PROCESSING_CALLBACK_URL=
# How many minutes a dispatched job may go without a worker callback before the mission page stops
# presenting it as in progress and reports it as having stopped reporting. OpenPlan cannot poll the
# worker, so this is about SILENCE, not about the job — the page says so either way. Optional;
# unset means 60. Depends on your worker: a fast-preview preset reports often, a high-quality
# reconstruction of a large corridor may be quiet for an hour between progress callbacks.
OPENPLAN_AERIAL_PROCESSING_SILENCE_MINUTES=
# Largest single processing artifact this deployment will pull into its own storage, in BYTES.
# On a succeeded callback OpenPlan downloads each artifact (orthomosaic, DSM, point cloud) into the
# private aerial-artifacts bucket, so the deliverables outlive the worker's time-limited links.
# Anything larger than this is REFUSED and recorded with the reason rather than filling the
# deployment's storage — and the refusal names this variable. Optional; unset means 256 MiB
# (268435456). Unlike the row caps elsewhere in OpenPlan, unset does NOT mean unlimited here: the
# bytes pass through the function's memory, and an unbounded default is how a large point cloud
# takes the callback endpoint down for every mission in the workspace. Raise it if your hardware
# can take it. This is configuration for whoever operates the deployment; OpenPlan is free and has
# no usage tiers.
OPENPLAN_AERIAL_ARTIFACT_MAX_BYTES=
# Largest single mission PHOTO the imagery upload route will accept, in bytes. Optional; unset
# means 64 MiB (67108864) — comfortably above the JPEG/TIFF frames mapping drones deliver. A
# deployment flying medium-format raw raises it; the refusal a planner meets names this variable.
# Like the artifact ceiling above, unset does NOT mean unlimited: the bytes pass through the
# upload route's memory. This is configuration for whoever operates the deployment; OpenPlan is
# free and has no usage tiers.
OPENPLAN_AERIAL_IMAGE_MAX_BYTES=
# Largest single file the Knowledge Base / document library upload will accept, in bytes.
# Optional; unset means 100 MiB (104857600) — sized for the scanned adopted plans and exhibit
# TIFFs planning offices actually hold. The refusal a planner meets names this variable. Unset
# does NOT mean unlimited: the bytes pass through the upload route. This is configuration for
# whoever operates the deployment; OpenPlan is free and has no usage tiers.
OPENPLAN_KB_DOCUMENT_MAX_BYTES=
# Wall-clock milliseconds the processing callback will spend taking custody before it stops starting
# new artifacts. Anything it does not reach is recorded `pending`, NOT lost, and finished by
# POST /api/aerial/processing-callback/custody while the worker's links are still valid. Optional;
# unset means 30000. Keep it well below your hosting platform's maximum function duration — the
# platform will kill the function at its own limit no matter what is set here.
OPENPLAN_AERIAL_CUSTODY_BUDGET_MS=

# OCR worker — reading SCANNED documents (workers/ocr_worker).
#
# Without these, a scanned PDF uploaded to the document library is stored,
# marked failed, and is permanently uncitable — which is most adopted plans
# older than a few years. That refusal stays honest either way: the library
# says this deployment has no OCR service rather than saying scans are
# unsupported. Set the pair (plus the callback token) and a planner gets a
# "Read with OCR" button on exactly those documents.
#
# The URL and the worker token are required TOGETHER — a URL with no token is
# treated as unconfigured, because this endpoint spends a machine's cores on
# request. See workers/ocr_worker/DEPLOY.md; it is a ten-minute checklist.
#
# Base URL of the OCR worker, e.g. http://localhost:8585.
OPENPLAN_KB_OCR_WORKER_URL=
# Bearer token OpenPlan presents when dispatching; must equal the worker's
# OPENPLAN_KB_OCR_WORKER_TOKEN.
OPENPLAN_KB_OCR_WORKER_TOKEN=
# Bearer token the worker presents on its callbacks; must equal the worker's
# OPENPLAN_KB_OCR_CALLBACK_BEARER_TOKEN. Required: without it the callback
# route answers 503 and no recognised text can ever land.
OPENPLAN_KB_OCR_CALLBACK_BEARER_TOKEN=
# Public base origin of this OpenPlan deployment for OCR callbacks (production
# must set this; falls back to the request origin in development).
OPENPLAN_KB_OCR_CALLBACK_URL=
# Which languages the recogniser should read with, in priority order. Tesseract
# language CODES, not locale tags: eng, spa, vie, chi_sim, nav… Comma- or
# plus-separated, up to eight. Optional; unset means "eng".
#
# THIS IS NOT COSMETIC. A Spanish-language plan read with the English model
# comes back looking exactly like text and saying nothing, and nothing
# downstream can tell. The worker REFUSES a language it has no trained data
# for, naming the code and listing what it has — so set this to what your
# agency's documents are actually written in, and install the matching
# tesseract-ocr-<lang> package in the worker image (see its Dockerfile).
OPENPLAN_KB_OCR_LANGUAGES=
# Largest OCR result this deployment will accept back from the worker, in bytes
# of serialized callback. Optional; unset means 4 MiB (4194304) — roughly a
# thousand pages of ordinary plan prose, and deliberately UNDER the 4.5 MB
# request-body limit a Vercel Function enforces and cannot be raised past. A
# self-hosted deployment has no such limit and can raise this to whatever its
# reverse proxy allows. A document whose text exceeds the ceiling FAILS naming
# both numbers rather than delivering part of itself: a document read only as
# far as a ceiling looks, from every screen downstream, exactly like a document
# that ends there.
OPENPLAN_KB_OCR_CALLBACK_MAX_BYTES=

# AequilibraE modeling worker — the OPTIONAL push endpoint.
#
# The worker can be run two ways, and neither costs anything. As a POLLER it
# reads queued runs out of Supabase and the app never calls it, which is what
# these two variables are for skipping. With them SET, the app also PUSHES each
# worker-backed run to the worker's HTTP trigger — which is what lets you run a
# stateless pool that wakes on a request instead of a machine that stays on, and
# is the only configuration in which OpenPlan can tell a planner AT LAUNCH
# whether anything actually took their run.
#
# Both are required together: a URL with no token is refused rather than used,
# because this endpoint starts minutes of compute on request. Set the same token
# on the worker (OPENPLAN_MODELING_WORKER_TOKEN) and run it with
# AEQ_WORKER_MODE=push (or "both" to keep polling as well — the two lanes cannot
# collide: every stage is taken with the same atomic claim, and within the one
# process the worker executes stages one at a time).
# The contract path is appended, so give the base URL: https://worker.example
#
# TWO THINGS A PUSH POOL ASKS OF YOU (workers/aequilibrae_worker/DEPLOY.md has
# the detail): the pool must stay alive while a run drains — the worker answers
# the push immediately and then executes for minutes, so give your platform a
# shutdown grace period at least as long as your longest stage — and CRON_SECRET
# above must be set with the sweep scheduled, because on a push-only deployment
# there is no poller to rescue a run whose worker went away.
OPENPLAN_MODELING_WORKER_URL=
OPENPLAN_MODELING_WORKER_TOKEN=

# Optional operator bound on how many model runs ONE workspace may have waiting
# on the processing worker at once. UNSET MEANS UNLIMITED and the counting query
# is skipped entirely — that is what every self-hosting agency gets. Set it only
# to protect compute you are paying for; the refusal names you, the operator,
# and never offers anyone an upgrade, because OpenPlan is free and has no tiers.
OPENPLAN_MODELING_QUEUE_DEPTH=

# Whether a worker POLLS this deployment. Still needed even with the push
# endpoint above, because they answer different questions: the URL says where a
# run can be pushed, this says whether anything is watching the queue.
#
# The app needs your ANSWER because a poller cannot be probed:
#   deployed | absent
# UNSET means "not declared", and nothing changes — the model launch controls
# go on inferring a missing worker from runs that were queued and then reaped.
# Declaring it is what makes the FIRST launch honest instead of the second: on
# `absent`, worker-backed runs are refused at the button naming this deployment
# rather than being queued and failed fifteen minutes later. It is deployment
# configuration, not a plan or a tier — OpenPlan is free either way — and what
# your runs show outranks it in both directions, so a retired worker cannot go
# on vouching for itself.
#
# IF YOU ONLY PUSH (a pool, nothing polling), LEAVE THIS UNSET. `absent` is
# literally true of that deployment — nothing is watching the queue — and it
# makes the launch button refuse every worker-backed run, including the ones
# your pool would have executed. `deployed` would claim a poller you do not run.
# Unset is the only answer that is both true and working; the push endpoint
# answers at launch, which is better than anything this variable can say.
OPENPLAN_MODELING_WORKER=

# --- Removed ---------------------------------------------------------------
# The Stripe/subscription/plan subsystem has been DELETED. OpenPlan is free and
# open source: there are no plans, no tiers, no quotas by plan, and no payment
# step. These variables no longer do anything and can be removed from any
# deployment:
#   OPENPLAN_STRIPE_*, STRIPE_SECRET_KEY, OPENPLAN_BILLING_*
#
# SWITRS_CSV_PATH is gone: the SWITRS crash export was retired in January 2025,
# and Safety reads the live CCRS API instead.
#
# OPENPLAN_ACCESS_REQUEST_REVIEW_EMAILS and
# OPENPLAN_WORKSPACE_PROVISIONING_SECRET are gone: the /admin operator console
# and the access-request queue were deleted — nothing gates access.

# ---------------------------------------------------------------------------
# Community-map upload ceilings — all OPTIONAL
# ---------------------------------------------------------------------------

# Ceilings on a context layer uploaded to a community-engagement map. Both
# refusals name the OPERATOR rather than the person uploading, because a
# deployment's own hardware is what decides whether one upload may become a
# 300 MB row. Note that a hosting platform imposes its OWN request-body limit
# underneath these (Vercel caps serverless request bodies at a few megabytes);
# self-hosting removes that, and no OpenPlan setting can.
# OPENPLAN_ENGAGEMENT_LAYER_FEATURE_CAP=
# OPENPLAN_ENGAGEMENT_LAYER_MAX_BYTES=

# ---------------------------------------------------------------------------
# Workspace GIS layers — the agency's own map data. ALL OPTIONAL
# ---------------------------------------------------------------------------

# Most shapes ONE map layer may hold. Optional; unset means UNLIMITED, which is
# what a single agency running its own deployment should leave it as — a county
# parcel fabric is a quarter of a million shapes and a cap below that refuses
# their real data. Someone hosting a shared deployment on their own hardware
# sets a number here to bound it. An upload larger than the cap is REFUSED
# WHOLE rather than trimmed: storing the first N shapes of a parcel fabric
# leaves a map with holes in it and nothing on screen to say so. The refusal
# names this variable and names the operator, because on a hosted deployment
# the planner reading it cannot buy anything — OpenPlan is free and has no
# usage tiers.
# OPENPLAN_WORKSPACE_LAYER_FEATURE_CAP=

# The GDAL conversion worker, for formats OpenPlan cannot read in-process — a
# file geodatabase (.gdb), a personal geodatabase (.mdb). BOTH must be set for
# a deployment to count as configured, and NEITHER IS USED BY THIS BUILD YET:
# there is no dispatch path, so a planner uploading a .gdb is told so and given
# the four-click export out of ArcGIS Pro or QGIS, which works today and needs
# no operator at all. Recorded here so the names are stable when the lane lands.
# OPENPLAN_SPATIAL_WORKER_URL=
# OPENPLAN_SPATIAL_WORKER_TOKEN=

# ---------------------------------------------------------------------------
# Transit feeds (GTFS) — all OPTIONAL. Every one of these has a default that
# works, and none of them gates a feature: leave the whole block unset and feed
# ingest behaves exactly as shipped. They exist because the right ceiling for a
# 200-stop rural operator and for Chicago are not the same number, and whoever
# runs a deployment is the only person who can know which one they are.
#
# OPENPLAN_OUTBOUND_ALLOWED_HOSTS — comma-separated hostnames the server is
# permitted to fetch when a planner pastes a feed URL. UNSET means "no extra
# restriction": the address is still refused if it is not https, carries
# credentials, uses a non-443 port, or resolves to a private range. Set this
# only if you want a hard list — for example, your own transit operator's
# domain and nothing else.
# OPENPLAN_OUTBOUND_ALLOWED_HOSTS=

# Archive size. The upload route refuses a larger file before reading it, and
# the transport limit deliberately sits above this domain limit — raising this
# past the transport cap gets you a bare "too large" instead of the GTFS
# refusal that explains itself.
# OPENPLAN_GTFS_MAX_ARCHIVE_BYTES=
# OPENPLAN_GTFS_MAX_MEMBER_UNCOMPRESSED_BYTES=
# OPENPLAN_GTFS_MAX_TOTAL_UNCOMPRESSED_BYTES=
# OPENPLAN_GTFS_MAX_COMPRESSION_RATIO=

# The FEED CATALOG's own size, which is a different artifact from a feed archive
# and needs a much smaller ceiling. The published catalog is about 1.15 MB of
# CSV and is parsed in memory in one pass, expanding roughly fourteen-fold — so
# a bound sized for a 200 MiB feed archive would let a catalog through that
# exhausts the process before any error handling can run. Lower this if your
# deployment reaches a mirror you want held to a tighter limit.
# OPENPLAN_GTFS_MAX_CATALOG_BYTES=

# How long a feed may take to parse, and how much of one is read at all. A feed
# that exceeds these is REFUSED and says so; it is never truncated into a
# partial answer that looks complete.
# OPENPLAN_GTFS_PARSE_BUDGET_MS=
# OPENPLAN_GTFS_MAX_ROWS_PER_TABLE=
# OPENPLAN_GTFS_MAX_SERVICE_DATES=
# OPENPLAN_GTFS_MAX_STOP_SERVICE_PAIRS=
# OPENPLAN_GTFS_MAX_ROUTE_SERVICE_PAIRS=
# OPENPLAN_GTFS_MAX_EXPANDED_FREQUENCY_DEPARTURES=
# OPENPLAN_GTFS_MAX_BUFFERED_FREQUENCY_STOP_TIMES=

# How much detail a refusal carries back. These bound the examples shown with a
# parse warning; they do not change what is accepted.
# OPENPLAN_GTFS_MAX_WARNING_EXAMPLES=
# OPENPLAN_GTFS_MAX_WARNING_EXAMPLE_CHARS=
