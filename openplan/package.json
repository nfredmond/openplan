{
  "name": "openplan",
  "version": "0.36.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@11.11.0",
  "scripts": {
    "predev": "npm run db:sync",
    "dev": "next dev",
    "db:sync": "npm exec -- supabase migration up --local --yes --output-format json",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:workspace-selection-hardening": "vitest run src/test/workspace-membership-current.test.ts src/test/workspace-membership-query-guard.test.ts src/test/plans-route.test.ts src/test/programs-route.test.ts src/test/funding-opportunities-route.test.ts src/test/models-route.test.ts src/test/rtp-cycles-route.test.ts src/test/engagement-campaigns-route.test.ts src/test/current-workspace-route.test.ts src/test/assistant-context-route.test.ts src/test/assistant-route.test.ts",
    "test:rls-live": "OPENPLAN_RLS_LIVE_TEST=1 vitest run src/test/rls-isolation.test.ts src/test/rls-viewer-denial.test.ts src/test/migration-schema-drift.test.ts src/test/policies-are-enforced-guard.test.ts src/test/gtfs-feed-status-mirrors-its-current-version.test.ts src/test/gtfs-persist.test.ts src/test/rtp-extraction-rls.test.ts src/test/measure-fund-rls.test.ts src/test/project-portfolio-import-rls.test.ts src/test/project-evidence-bundle-rls.test.ts",
    "test:watch": "vitest",
    "test:shuffled": "node scripts/ops/test-shuffled.mjs",
    "seed:workspace-isolation": "tsx scripts/seed-local-workspace-isolation.ts",
    "worker:aequilibrae": "bash ../workers/aequilibrae_worker/run.sh",
    "worker:activitysim": "bash ../workers/activitysim_worker/run.sh",
    "modeling:local": "bash ../scripts/run-local-modeling.sh",
    "modeling:up": "docker compose -f ../workers/county_onramp_worker/docker-compose.yml up -d --build",
    "modeling:down": "docker compose -f ../workers/county_onramp_worker/docker-compose.yml down",
    "modeling:logs": "docker compose -f ../workers/county_onramp_worker/docker-compose.yml logs -f",
    "ops:check-prod-health": "node scripts/ops/check-prod-health.mjs",
    "ops:log-prod-health-evidence": "node scripts/ops/log-prod-health-evidence.mjs",
    "ops:check-public-demo-preflight": "node scripts/ops/check-public-demo-preflight.mjs",
    "qa:gate": "npm run product:direction:check && npm run lint && npm run deadcode && npm test && node scripts/ops/rls-gate.mjs && npm audit --omit=dev --audit-level=moderate && npm run build",
    "qa:gate:log": "mkdir -p ../docs/ops/2026-03-01-test-output && (npm run qa:gate) | tee ../docs/ops/2026-03-01-test-output/2026-03-01-clean-gate.log",
    "ops:check-local-supabase-status": "node scripts/ops/check-local-supabase-status.mjs",
    "ops:check-migration-inventory": "node scripts/ops/check-migration-inventory.mjs",
    "ops:check-pilot-preflight": "node scripts/ops/check-pilot-preflight.mjs",
    "ops:restore-drill": "bash scripts/ops/disposable-restore-drill.sh",
    "ops:verify-project-evidence-bundle": "tsx scripts/ops/verify-project-evidence-bundle.mts",
    "test:guardrail-suite": "vitest run src/test/no-paid-tier-guard.test.ts src/test/qa-harness-route-contract-guard.test.ts src/test/public-page-claims-guardrails.test.ts src/test/public-open-source-posture-guardrail.test.ts src/test/public-page-metadata-canonical-url.test.ts src/test/workspaces-bootstrap-route.test.ts src/test/workspace-membership-current.test.ts src/test/workspace-membership-required.test.tsx",
    "qa:first-week": "npm --prefix ../qa-harness run first-week-discovery",
    "qa:first-week-regression": "npm --prefix ../qa-harness run first-week-regression",
    "doctor": "node scripts/doctor.mjs",
    "deadcode": "knip --no-progress",
    "test:workers": "node scripts/ops/test-workers.mjs",
    "product:direction:check": "node scripts/ops/product-direction-review.mjs --check",
    "product:direction:packet": "node scripts/ops/product-direction-review.mjs --packet"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.46",
    "@sparticuz/chromium": "^129.0.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.110.7",
    "ai": "^6.0.94",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.12.0",
    "mapbox-gl": "^3.20.0",
    "marked": "^14.1.4",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "puppeteer-core": "^25.6.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "unpdf": "^1.6.2",
    "xlsx": "file:vendor/sheetjs/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^28.1.0",
    "knip": "^6.29.0",
    "shadcn": "^3.8.5",
    "supabase": "^2.76.11",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "basic-ftp": "5.3.1",
    "fast-xml-builder": "1.1.7",
    "fast-xml-parser": "5.7.1",
    "ip-address": "10.4.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "protocol-buffers-schema": "3.6.1",
    "ws": "8.21.1",
    "qs": "6.15.3",
    "sharp": "0.35.3"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp@<=5.3.0": "5.3.1",
      "fast-xml-builder@<=1.1.6": "1.1.7",
      "fast-xml-parser@<5.7.0": "5.7.1",
      "ip-address@<10.2.2": "10.4.0",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23",
      "protocol-buffers-schema@<3.6.1": "3.6.1",
      "ws@<8.21.1": "8.21.1",
      "qs@<6.15.3": "6.15.3",
      "sharp@<0.35.0": "0.35.3"
    }
  }
}
