  "properties": {
    "schema": {"const": "openplan.model-validation-assignment-blind-diagnosis.v1"},
    "diagnosis_stage": {"const": "assignment_blind"},
    "geography_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "model_output_bytes_read": {"const": false},
    "exact_inputs": {"type": "object"},
    "jurisdictions": {"type": "object"},
    "source_attempts": {"type": "array"},
    "observation": {"type": "object"},
    "matching": {"type": "object"},
    "findings": {"type": "array"},
