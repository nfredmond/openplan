{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplan.org/schemas/observed_traffic_observation.v2.schema.json",
  "title": "Observed traffic observation v2",
  "type": "object",
  "required": ["schema", "observation_id", "site_id", "series_id", "source_kind", "observation_status", "source", "route_lrs", "geometry", "direction_lane_carriageway", "facility", "vehicle_basis", "time_basis", "measurements", "estimate", "evidence_grade", "duplicate_lineage"],
  "properties": {
    "schema": {"const": "openplan.observed-traffic-observation.v2"},
    "observation_id": {"type": "string", "minLength": 1},
    "site_id": {"type": "string", "minLength": 1},
    "series_id": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["point", "section"]},
    "observation_status": {"enum": ["eligible", "excluded", "unsupported", "unresolved"]},
    "geometry": {"type": "object", "required": ["type", "coordinates", "crs"]},
    "measurements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["measurement_id", "source_member_path", "source_member_sha256", "period", "value", "unit", "complete", "exact_record_sha256"]}}
  },
  "additionalProperties": true
}
