{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openplan.development-validation-study-result.v1",
  "title": "OpenPlan development validation study result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "study_id", "created_at", "git_sha", "app_version",
    "preregistration_sha256", "readiness", "counties", "method_aggregation",
    "scientific_outcome", "claims"
  ],
  "properties": {
    "schema": {"const": "openplan.development-validation-study-result.v1"},
    "study_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "app_version": {"type": "string", "minLength": 1},
    "preregistration_sha256": {"$ref": "#/$defs/sha256"},
    "readiness": {"enum": ["ready", "not_ready"]},
    "counties": {"type": "array", "items": {"type": "object"}},
    "method_aggregation": {"const": "separate"},
    "scientific_outcome": {"enum": ["inconclusive"]},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["california", "nationwide", "defaults_changed", "calibrated", "acceptance_holdout_opened"],
      "properties": {
        "california": {"const": "partial"},
        "nationwide": {"const": "partial"},
        "defaults_changed": {"const": false},
        "calibrated": {"const": false},
        "acceptance_holdout_opened": {"const": false}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
