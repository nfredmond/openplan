{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openplan.sealed-study.aggregate-result.v1",
  "title": "OpenPlan sealed study aggregate result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "status", "decision", "execution", "recorded_at"],
  "properties": {
    "schema_version": { "const": "openplan.sealed-study.aggregate-result.v1" },
    "study_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["evaluated_once", "evaluated_once_inconclusive"] },
    "decision": { "enum": ["accepted", "rejected", "inconclusive"] },
    "evaluator_result": { "type": "object" },
    "inconclusive_error_kind": { "type": "string", "minLength": 1 },
    "inconclusive_reason": { "type": "string", "minLength": 1 },
    "execution": { "type": "object" },
    "evidence": { "type": "object" },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    {
      "properties": { "status": { "const": "evaluated_once" } },
      "required": ["evaluator_result", "evidence"],
      "not": { "anyOf": [
        { "required": ["inconclusive_error_kind"] },
        { "required": ["inconclusive_reason"] }
      ] }
    },
    {
      "properties": { "status": { "const": "evaluated_once_inconclusive" } },
      "required": ["inconclusive_error_kind", "inconclusive_reason"],
      "not": { "anyOf": [
        { "required": ["evaluator_result"] },
        { "required": ["evidence"] }
      ] }
    }
  ]
}
