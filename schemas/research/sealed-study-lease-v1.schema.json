{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openplan.sealed-study.lease.v1",
  "title": "OpenPlan sealed study host lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "lock_sha256", "host", "pid", "acquired_at"],
  "properties": {
    "schema_version": { "const": "openplan.sealed-study.lease.v1" },
    "study_id": { "type": "string", "minLength": 1 },
    "lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "host": { "type": "string", "minLength": 1 },
    "pid": { "type": "integer", "minimum": 1 },
    "acquired_at": { "type": "string", "format": "date-time" }
  }
}
