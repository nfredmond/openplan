{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openplan.sealed-study.receipt.v1",
  "title": "OpenPlan sealed study receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "status",
    "lock_sha256",
    "source_sha256",
    "selected_members_uncompressed_bytes",
    "required_scratch_bytes",
    "written_at"
  ],
  "properties": {
    "schema_version": { "const": "openplan.sealed-study.receipt.v1" },
    "study_id": { "type": "string", "minLength": 1 },
    "status": { "const": "source_consumed_before_first_selected_member_read" },
    "lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "selected_members_uncompressed_bytes": { "type": "integer", "minimum": 0 },
    "required_scratch_bytes": { "type": "integer", "minimum": 1073741824 },
    "written_at": { "type": "string", "format": "date-time" }
  }
}
