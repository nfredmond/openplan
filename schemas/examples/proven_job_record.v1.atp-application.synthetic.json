  "limits": [
    {"id": "synthetic-example", "text": "Synthetic example for the checker tests. It is not evidence and names no real place, run, application or file."},
    {"id": "no-pdf-ua-check", "text": "No PDF/UA check was run on the application PDFs."},
    {"id": "no-keyboard-or-screen-reader-pass", "text": "No keyboard-only or screen-reader pass was made."},
    {"id": "no-human-usefulness-review", "text": "No planner reviewed whether the application PDFs are useful. Agent-run checks are the acceptance evidence."},
    {
      "id": "rehearsal-of-a-closed-call",
      "text": "The run is a rehearsal on the 2027 Small Infrastructure forms. The statewide call closed June 22, 2026 (KI-2026-11-16-075). No application was submitted to the Commission, and no agency or tribe made or submitted one."
    },
    {
      "id": "attachments-not-produced",
      "text": "No attachment was produced. An agent cannot honestly produce a signature page, an engineer's checklist or the other documents, so every checklist row is outstanding or marked not applicable with a reason, and every PDF is stamped DRAFT with the count of required attachments outstanding."
    },
    {"id": "not-a-commission-score", "text": "The only scores in the PDFs are OpenPlan screening scores. They are not Commission scores and forecast no ranking, award or benefit."},
    {
      "id": "no-eligibility-or-disadvantaged-community-determination",
      "text": "Nothing in the PDFs or in this record is an eligibility finding, a disadvantaged community determination or a finding that an application would pass the Commission's screening."
    },
    {
      "id": "section-text-is-a-labeled-demonstration",
      "text": "Every section's text was typed by an automated proof run under a demonstration label. It describes no real project and speaks for no agency or tribe. Nothing checks that it says anything true about a place."
    },
    {"id": "small-application-only", "text": "Only the Small infrastructure application was run. The Medium, Large, Non-infrastructure and Plan applications were not."},
    {"id": "applicant-name-cannot-be-entered", "text": "OpenPlan cannot yet hold an applicant's name (KI-2026-11-16-080), so every PDF prints that the applicant is not entered in OpenPlan."},
    {
      "id": "equity-inputs-as-each-run-found-them",
      "text": "The job does not require Census tract data. Where a run retrieved none, its equity score is withheld and Appendix E says no tract data was retrieved. Each journey's record says which happened."
    },
    {
      "id": "what-the-journey-leaves-on-the-hosted-site",
      "text": "Each journey leaves its account, workspace, project, crash records, analysis run, tracked opportunity, application and exported PDF on the hosted site under the demonstration label. It publishes nothing and opens no public page."
    },
    {
      "id": "read-by-the-journey",
      "text": "The journey read these and the checker cannot read them again: which states the Census Bureau lists for the tribal area, the crash counts stored, each section's and each checklist row's state on screen, the statuses the owner and the second account received, the accessibility results, console errors and sideways scroll of each screen, and which build, mode and harness checkout ran."
    },
    {
      "id": "project-page-answers-200-with-not-found-screen",
      "text": "Another workspace's project page answers HTTP 200 with the not-found screen, because the page streams. The journey read the rendered page: the not-found screen was on it and none of the first account's identifying strings was in its text or HTML. The application read and the PDF download were refused."
    }
  ]
