{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "workers/hosted-backup/Dockerfile",
    "watchPatterns": ["/workers/hosted-backup/**"]
  },
  "deploy": {
    "cronSchedule": "17 10 * * *",
    "restartPolicyType": "NEVER"
  }
}
