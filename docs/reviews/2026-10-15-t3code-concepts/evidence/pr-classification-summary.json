{
  "rules": {
    "provider-integration": {
      "relevance": "A",
      "regex": "\\b(codex|claude|opencode|open ?code|cursor[- ]agent|cursor sdk|grok|acp\\b|antigravity|muse code|\\bpi\\b agent|provider (adapter|driver|instance)|app-server|agent sdk|provider[s]?\\b)"
    },
    "provider-accounts-limits": {
      "relevance": "A",
      "regex": "(sign[- ]?in|log ?in\\b|login|logout|sign[- ]?out|account[s]?\\b|subscription|usage limit|rate[- ]limit|quota|reset time|chatgpt plan|api key|credential)"
    },
    "approvals-permissions": {
      "relevance": "A",
      "regex": "(approv|permission|runtime mode|full access|supervised|auto-accept|sandbox|allow once|deny|escalat)"
    },
    "durable-orchestration-recovery": {
      "relevance": "A",
      "regex": "(orchestrat|event[- ]sourc|outbox|command receipt|receipt|idempot|recover|restart continu|resume|reconcil|effect worker|projection|replay|crash|interrupt|durable|at-least-once|exactly-once|lease)"
    },
    "delegation-subagents-handoff": {
      "relevance": "A",
      "regex": "(subagent|sub-agent|delegat|child thread|task_status|delegate_task|fork|merge[- ]back|handoff|context transfer)"
    },
    "mcp-external-agents": {
      "relevance": "A",
      "regex": "(\\bmcp\\b|oauth|outside agent|model context protocol|tool call|toolkit)"
    },
    "scheduled-automation-webhooks": {
      "relevance": "A",
      "regex": "(schedul|cron|webhook|automation|recurring|watch_pull_request|wake)"
    },
    "notifications-mobile-offline": {
      "relevance": "A",
      "regex": "(notification|push\\b|apns|fcm|live activit|live update|widget|offline|outbox queue|queued message)"
    },
    "observability-diagnostics": {
      "relevance": "A",
      "regex": "(trace|tracing|otel|opentelemetry|telemetry|metric|diagnostic|posthog|heap snapshot|event loop|stall|observab|log file|logging)"
    },
    "update-install-migration-rollback": {
      "relevance": "A",
      "regex": "(self-update|t3 update|update server|launcher|install(er|ation)?\\b|rollback|roll back|migration|migrate|downgrade|release channel|nightly|service install|systemd|launchd)"
    },
    "data-portability-export-import": {
      "relevance": "A",
      "regex": "(export|import|backup|restore|portab|statev2|sqlite copy|recovery copy)"
    },
    "usage-cost-accounting": {
      "relevance": "A",
      "regex": "(usage page|\\busage\\b|cost|pricing|price|token (use|usage|count)|cache hit)"
    },
    "evidence-artifacts-rendering": {
      "relevance": "A",
      "regex": "(html render|visual repl|attachment|file preview|pdf|artifact|screenshot|snapshot|image|video|csv|mcp app)"
    },
    "citations-context-references": {
      "relevance": "A",
      "regex": "(citation|cite\\b|quote|context chip|context reference|context record|mention|prompt link|t3-context)"
    },
    "collaboration-review": {
      "relevance": "B",
      "regex": "(pull request|\\bpr\\b|review guide|review comment|code review|viewed file|reviewer|stack(ed)?\\b|merge queue|comment)"
    },
    "remote-access-connectivity": {
      "relevance": "B",
      "regex": "(remote|relay|tunnel|tailscale|\\bssh\\b|pairing|t3 connect|reconnect|dpop|connection|route[s]?\\b|lan\\b)"
    },
    "auth-security-hardening": {
      "relevance": "A",
      "regex": "(security|vulnerab|xss|csrf|injection|prompt injection|secret|redact|token|scope[s]?\\b|authoriz|authenticat|invisible character|zero-width)"
    },
    "accessibility-i18n": {
      "relevance": "A",
      "regex": "(a11y|accessib|screen reader|aria|voiceover|keyboard focus|focus trap|i18n|locale|translation|rtl\\b|contrast|reduced motion)"
    },
    "settings-config-layering": {
      "relevance": "B",
      "regex": "(settings?\\b|override|inherit|project setting|environment default|preference|t3\\.json)"
    },
    "performance-scaling": {
      "relevance": "B",
      "regex": "(perf\\b|performance|memory|cpu|gpu|virtualiz|lag|jank|slow|latency|throughput|payload|bounded|pagination|paginat)"
    },
    "testing-verification": {
      "relevance": "B",
      "regex": "(test|fixture|replay fixture|e2e|regression|verif|smoke|canary|mutation)"
    },
    "docs-policy-process": {
      "relevance": "B",
      "regex": "(\\bdocs?\\b|documentation|contributing|triage|agents\\.md|readme|policy|license|notice)"
    },
    "ui-workflow-general": {
      "relevance": "C",
      "regex": "(sidebar|composer|theme|keybinding|shortcut|command palette|thread list|snooze|settle|pin(ned)?\\b|drag|toast|banner|modal|dialog)"
    },
    "source-control-git": {
      "relevance": "C",
      "regex": "(\\bgit\\b|worktree|branch|commit|checkpoint|diff|rebase|github|gitlab|bitbucket|forgejo|gitea|azure devops)"
    },
    "terminal-devices-browser": {
      "relevance": "C",
      "regex": "(terminal|\\bpty\\b|ghostty|device panel|simulator|emulator|browser panel|preview browser|headless (chrome|browser)|cua\\b|snapshot capture|snap ?shot|wayland|hyprland|niri)"
    },
    "voice-input": {
      "relevance": "C",
      "regex": "(voice|dictat|transcri|microphone|speech)"
    },
    "desktop-native-packaging": {
      "relevance": "C",
      "regex": "(electron|desktop app|dmg|appimage|\\.deb|nsis|winget|homebrew|aur\\b|codesign|notariz)"
    },
    "marketing-site": {
      "relevance": "C",
      "regex": "(marketing|landing page|website copy)"
    }
  },
